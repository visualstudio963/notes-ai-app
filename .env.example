PORT=3000
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/notesDB?retryWrites=true&w=majority
JWT_SECRET=use-a-long-random-string
JWT_REFRESH_SECRET=use-a-different-long-random-string

# Backend API base URL (used by the static app via frontend/public/js/config/api-base.js fallback / build env).
VITE_API_URL=https://notes-ai-backend-lykf.onrender.com

# Official production frontend (Vercel). Use this on your deployed API host for redirects after OAuth / Stripe.
# Local dev: http://localhost:3000
PUBLIC_APP_URL=https://notes-ai-app-theta.vercel.app

# Google Sign-In (OAuth 2.0 Client ID from Google Cloud Console → APIs & Services → Credentials → Web client)
# Same value is exposed to the frontend via GET /api/public/app-config as googleClientId (safe).
GOOGLE_CLIENT_ID=
# Web client secret — Passport Google OAuth (GET /auth/google → /auth/google/callback).
GOOGLE_CLIENT_SECRET=
# OAuth redirect URI must hit your API server (where Passport runs), e.g. Render — not the Vercel static URL.
# Must match Google Cloud “Authorized redirect URI” exactly.
GOOGLE_CALLBACK_URL=https://notes-ai-backend-lykf.onrender.com/auth/google/callback
# Legacy alias for GOOGLE_CALLBACK_URL (optional).
GOOGLE_REDIRECT_URI=
# Optional: session cookie secret for Passport OAuth state (defaults to JWT_SECRET).
SESSION_SECRET=

# OpenAI (server-side secret)
OPENAI_API_KEY=

# Stripe
# Secret keys must stay server-side only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STANDARD_MONTHLY=
STRIPE_STANDARD_YEARLY=
STRIPE_PREMIUM_MONTHLY=
STRIPE_PREMIUM_YEARLY=

# Safe-to-expose key (can be sent to frontend via /api/public/app-config)
STRIPE_PUBLISHABLE_KEY=

# Optional: Twilio (SMS + WhatsApp)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Optional: local Premium testing (WhatsApp/SMS reminders via Twilio — see backend/src/features/premium/)
# POST /api/premium/activate-dev with JSON { "secret": "<same value>", "days": 30 } while logged in.
PREMIUM_DEV_SECRET=

# Put real keys in your local `.env` file (project root), never in source code.

# Admin panel (/admin): no extra env. Promote a user in MongoDB, e.g.
# db.users.updateOne({ username: "yourname" }, { $set: { role: "admin" } })
