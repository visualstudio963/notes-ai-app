PORT=3000
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/notesDB?retryWrites=true&w=majority
JWT_SECRET=use-a-long-random-string
JWT_REFRESH_SECRET=use-a-different-long-random-string

# Backend API base URL (static app fallback in frontend/public/js/config/api-base.js)
VITE_API_URL=https://notes-ai-app.onrender.com

# Production frontend URL — OAuth / Stripe redirects; also used for Invite Friends links in APK
# Must match <meta name="notes-ai-public-url"> in frontend/public/index.html
PUBLIC_APP_URL=https://notes-ai-app-theta.vercel.app

# Google Sign-In (Google Cloud Console → Credentials → Web client)
# Exposed to frontend via GET /api/public/app-config as googleClientId
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud "Authorized redirect URI" (API host, not static Vercel URL)
GOOGLE_CALLBACK_URL=https://notes-ai-app.onrender.com/auth/google/callback
GOOGLE_REDIRECT_URI=
SESSION_SECRET=

# Stripe — Standard plan only (server-side secrets)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STANDARD_MONTHLY=
STRIPE_STANDARD_YEARLY=
# Safe to expose via /api/public/app-config
STRIPE_PUBLISHABLE_KEY=

# Optional: local Standard testing — POST /api/premium/activate-dev while logged in
PREMIUM_DEV_SECRET=

# Web Push (optional — reminders when the app is closed)
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Put real keys in your local `.env` file (project root), never in source code.

# Admin panel (/admin): promote a user in MongoDB, e.g.
# db.users.updateOne({ username: "yourname" }, { $set: { role: "admin" } })
