{
  "name": "notes-ai-webapp",
  "version": "1.0.0",
  "description": "Notes app with Express API and static frontend",
  "private": true,
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "server": "node backend/src/server.js",
    "stripe:server": "node backend/stripe-checkout-server.js",
    "stripe:webhook": "node backend/stripe-webhook-server.js",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:sync:dev": "node scripts/capacitor-dev.mjs sync",
    "cap:copy:dev": "node scripts/capacitor-dev.mjs copy",
    "cap:run:android:dev": "node scripts/capacitor-dev.mjs run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/camera": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/local-notifications": "^8.0.2",
    "bcrypt": "^5.1.0",
    "body-parser": "^2.2.2",
    "chrono-node": "^2.7.5",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.5.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.5",
    "socket.io": "^4.7.2",
    "stripe": "^14.25.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
