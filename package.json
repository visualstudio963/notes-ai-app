{
  "name": "notes-ai-webapp",
  "version": "1.0.0",
  "description": "Notes app with Express API and static frontend",
  "private": true,
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "server": "node backend/src/server.js",
    "build:note-editor": "esbuild editor/note-rich-editor.js --bundle --outfile=frontend/public/js/note-rich-editor.bundle.js --format=iife --platform=browser",
    "stripe:server": "node backend/stripe-checkout-server.js",
    "stripe:webhook": "node backend/stripe-webhook-server.js",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:sync:dev": "node scripts/capacitor-dev.mjs sync",
    "cap:copy:dev": "node scripts/capacitor-dev.mjs copy",
    "cap:run:android:dev": "node scripts/capacitor-dev.mjs run android",
    "vercel-build": "node scripts/inject-build-hash.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/camera": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/local-notifications": "^8.0.2",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/html": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "bcrypt": "^5.1.0",
    "body-parser": "^2.2.2",
    "chrono-node": "^2.7.5",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.5.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.7.2",
    "stripe": "^14.25.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
