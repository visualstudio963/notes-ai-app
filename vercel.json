{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://notes-ai-app.onrender.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://notes-ai-app.onrender.com/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/index.html"
    },
    {
      "source": "/set-password",
      "destination": "/index.html"
    },
    {
      "source": "/set-password/",
      "destination": "/index.html"
    },
    {
      "source": "/choose-username",
      "destination": "/index.html"
    },
    {
      "source": "/choose-username/",
      "destination": "/index.html"
    },
    {
      "source": "/billing",
      "destination": "/index.html"
    },
    {
      "source": "/billing/",
      "destination": "/index.html"
    },
    {
      "source": "/success",
      "destination": "/index.html"
    },
    {
      "source": "/success/",
      "destination": "/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/index.html"
    },
    {
      "source": "/pricing/",
      "destination": "/index.html"
    },
    {
      "source": "/invite/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
